[Unit]
Description=Synology to Nextcloud Talk Bridge
After=network.target

[Service]
User=synology-talk
Group=synology-talk

WorkingDirectory=/opt/synology-talk-bridge

EnvironmentFile=/etc/synology-talk-bridge.env

ExecStart=/usr/bin/python3 /opt/synology-talk-bridge/app.py

Restart=always
RestartSec=5

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
